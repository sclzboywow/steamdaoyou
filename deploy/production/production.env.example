# Copy to /root/daoyou/.env.production and replace every CHANGE_ME value.
# Keep this file out of Git after filling real secrets.

# ----- Deployment / domain -----
API_DOMAIN=steam-api.yzdoc.cn
APP_NETWORK=daoyou-runtime
BLUE_PORT=3000
GREEN_PORT=3001
BLUE_CONTAINER=daoyou-app-blue
GREEN_CONTAINER=daoyou-app-green
# Leave empty to auto-detect a container named 1Panel-openresty-*.
OPENRESTY_CONTAINER=
UPSTREAM_CONF=/opt/1panel/www/sites/steam-api.yzdoc.cn/upstream/daoyou_backend.conf
DEPLOY_STATE_FILE=/root/daoyou/deploy-state.env
OLD_CONTAINER_GRACE_SECONDS=90

# ----- Backup -----
BACKUP_DIR=/root/daoyou/backups
BACKUP_RETENTION_DAYS=14
BACKUP_STATUS_FILE=/root/daoyou/runtime/backup-status.env

# ----- Host operations / disk / logs -----
OPS_RUNTIME_DIR=/root/daoyou/runtime
OPS_STATUS_FILE=/run/daoyou/ops-status.json
OPS_DISK_PATH=/
OPS_TLS_DOMAIN=steam-api.yzdoc.cn
# Confirm the real 1Panel host log directory before setting this.
OPENRESTY_LOG_DIR=
INSTALL_OPS_MONITOR=1
INSTALL_OPENRESTY_LOGROTATE=1
INSTALL_JOURNAL_LIMIT=1
JOURNAL_SYSTEM_MAX_USE=500M
JOURNAL_RUNTIME_MAX_USE=200M
KEEP_APP_IMAGE_VERSIONS=5
CLEANUP_OLD_APP_IMAGES=1

# ----- Infrastructure images -----
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
NATS_IMAGE=nats:2.11-alpine

# ----- PostgreSQL -----
POSTGRES_DB=daoyou
POSTGRES_USER=daoyou
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# URL-encode the password if it contains reserved URI characters.
DATABASE_URL=postgresql://daoyou:CHANGE_ME_POSTGRES@postgres:5432/daoyou
DB_MAX_CONNECTIONS=10

# ----- Redis -----
REDIS_PASSWORD=CHANGE_ME_REDIS
REDIS_URL=redis://default:CHANGE_ME_REDIS@redis:6379/0

# ----- NATS / JetStream -----
NATS_SERVERS=nats://nats:4222
NATS_USER=app
NATS_PASSWORD=CHANGE_ME_NATS
NATS_CLIENT_NAME=
CRON_SECRET=CHANGE_ME_CRON_SECRET

# ----- Runtime -----
PORT=3000
APP_ENV=production
API_IP_RATE_LIMIT_WINDOW_SECONDS=60
API_IP_RATE_LIMIT_MAX_REQUESTS=300

# ----- Better Auth / CORS -----
BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET
BETTER_AUTH_URL=https://steam-api.yzdoc.cn
# Steam/Tauri production origin. Add any official web origin if you operate one.
PUBLIC_WEB_ORIGINS=http://tauri.localhost,https://admin.yzdoc.cn
BETTER_AUTH_CROSS_SITE_COOKIES=true
# Leave BETTER_AUTH_COOKIE_DOMAIN unset for cross-site Tauri -> HTTPS API usage.

# ----- Steam server auth -----
STEAM_APP_ID=CHANGE_ME_STEAM_APP_ID
STEAM_WEB_API_KEY=CHANGE_ME_STEAM_WEB_API_KEY
STEAM_WEB_API_IDENTITY=wanjie-daoyou-steam

# ----- Captcha / moderation -----
ALTCHA_HMAC_SECRET=CHANGE_ME_ALTCHA_HMAC_SECRET
CONTENT_SAFETY_HTTP_URL=
CONTENT_SAFETY_HTTP_TOKEN=
CONTENT_SAFETY_FAIL_CLOSED=true
CONTENT_SAFETY_LOG_TEXT=false
CONTENT_SAFETY_LOG_PASSES=false

# ----- Mail -----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yzdoc.cn

# ----- LLM -----
LLM_PROVIDER=
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=

# ----- Admin -----
ADMIN_USER_IDS=
ADMIN_OPS_USER_IDS=
ADMIN_SUPPORT_USER_IDS=
ADMIN_CONTENT_USER_IDS=
ADMIN_WEB_ORIGINS=https://admin.yzdoc.cn

# Build-time Steam client variables are NOT read from this runtime file:
# VITE_DISTRIBUTION_CHANNEL=steam
# VITE_API_BASE_URL=https://steam-api.yzdoc.cn
# VITE_ADMIN_WEB_ORIGIN=https://admin.yzdoc.cn
# VITE_STEAM_APP_ID=<same app id>
# VITE_STEAM_WEBAPI_IDENTITY=wanjie-daoyou-steam
