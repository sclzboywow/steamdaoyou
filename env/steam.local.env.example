# Steam V0.2.1 local development only.
# Copy to env/steam.local.env. The installer creates it automatically if absent.
# This file contains NO production secret.

# Client / Tauri dev
VITE_DISTRIBUTION_CHANNEL=steam
VITE_API_BASE_URL=
VITE_PUBLIC_WEB_ORIGIN=http://127.0.0.1:5174
# Leave empty for local Vite public/fonts and public/assets/maps.
# Production steam:build requires an HTTPS official static origin.
VITE_ASSET_BASE_URL=
VITE_STEAM_APP_ID=480
VITE_STEAM_WEBAPI_IDENTITY=wanjie-daoyou-local
VITE_STEAM_AUTH_DEV_BYPASS=true
VITE_STEAM_DEV_USER_ID=76561198000000000
VITE_STEAM_DEV_PERSONA_NAME=本地测试道友
# With the bypass above, local steam:dev may open /#/admin (prod Steam builds still block it).

# Server-side local-only Steam bypass.
# The server also requires APP_ENV=local and NODE_ENV!=production.
# Also unlocks /api/admin from the Steam/Tauri client during local mock only.
STEAM_AUTH_DEV_BYPASS=true
STEAM_APP_ID=480
STEAM_WEB_API_IDENTITY=wanjie-daoyou-local
STEAM_DEV_USER_ID=76561198000000000

# Local official-content safety may fail open while the semantic provider is absent.
CONTENT_SAFETY_FAIL_CLOSED=false

# Vite dev origin + Tauri production protocol for local testing.
PUBLIC_WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://tauri.localhost
